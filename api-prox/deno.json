{
  "imports": {
    "hono": "jsr:@hono/hono@^4.9.6"
  },
  "tasks": {
    "deno-run": "deno run --sloppy-imports --allow-net deno.ts",
    "deno-dev": "deno run --sloppy-imports --unstable-hmr --allow-net deno.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  }
}