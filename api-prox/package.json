{
  "name": "anixart-serverless-api-proxy",
  "type": "module",
  "scripts": {
    "bun-dev": "bun run --hot src/index.ts",
    "deno-dev": "deno serve --sloppy-imports --unstable-hmr src/index.ts",
    "vc-dev": "vercel dev",
    "vc-deploy": "vercel deploy",
    "cf-dev": "wrangler dev",
    "cf-deploy": "wrangler deploy --minify"
  },
  "dependencies": {
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/deno": "latest",
    "typescript": "^5.9.2",
    "vercel": "^47.0.5",
    "wrangler": "^4.4.0"
  },
  "overrides": {
    "@vercel/node": {
      "ts-node": "10.9.2",
      "typescript": "5.9.2"
    }
  }
}