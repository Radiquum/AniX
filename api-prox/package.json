{
  "name": "anixart-serverless-api-proxy",
  "type": "module",
  "scripts": {
    "node-dev": "tsx watch node.ts",
    "node-run": "npx tsx node.ts",
    "bun-dev": "bun run --hot bun.ts",
    "bun-run": "bun run bun.ts",
    "vc-dev": "vercel dev",
    "vc-deploy": "vercel deploy",
    "vc-prod": "vercel --prod",
    "cf-dev": "wrangler dev",
    "cf-deploy": "wrangler deploy --minify"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.6",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/deno": "latest",
    "typescript": "^5.9.2",
    "vercel": "^47.0.5",
    "wrangler": "^4.4.0"
  },
  "overrides": {
    "@vercel/node": {
      "ts-node": "10.9.2",
      "typescript": "5.9.2"
    }
  }
}